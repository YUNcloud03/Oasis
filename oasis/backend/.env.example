# OASIS backend env — copy this file to .env, then fill in real values.
# .env is gitignored. Never commit it.

# Database (default: local SQLite file in backend/)
DATABASE_URL=sqlite:///./oasis.db

# Generate a strong secret:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-string

# Your OpenAI key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_MODEL=gpt-4o

# Shared bearer token used by the front-end to call /api/* endpoints.
# Generate the same way as JWT_SECRET_KEY above.
APP_TOKEN=replace-with-a-long-random-string
